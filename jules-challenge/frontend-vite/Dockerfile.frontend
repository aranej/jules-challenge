# Stage 1: Build Stage
FROM node:18-alpine AS build

# Set working directory
WORKDIR /app

# Copy package.json and package-lock.json (if available)
# Copying these first leverages Docker cache if they haven't changed
COPY package-lock.json* ./
COPY package.json ./

# Install dependencies
# Using npm ci for cleaner, reproducible builds if package-lock.json is present
# Otherwise, fallback to npm install
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi

# Copy the rest of the application code
# This includes src/, public/, vite.config.ts, tsconfig.json, etc.
COPY . .

# Build the application
# This script should generate static files in the /app/dist folder
RUN npm run build

# Stage 2: Production Stage
# Use a lightweight Nginx image to serve the static files
FROM nginx:1.25-alpine

# Copy built artifacts from the 'build' stage
# The source path /app/dist is where Vite places the build output in the 'build' stage
COPY --from=build /app/dist /usr/share/nginx/html

# Copy custom Nginx configuration for SPA routing
# This replaces the default Nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Expose port 80 (Nginx default)
EXPOSE 80

# Nginx will start automatically based on the base image's default CMD.
# No explicit CMD is needed here unless you want to override the default Nginx behavior.
# Default CMD for nginx:alpine is typically ["nginx", "-g", "daemon off;"]
